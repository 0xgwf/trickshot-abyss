#!/bin/sh
# Enforce Conventional Commits on the first line, e.g. "feat: 新增第三层".
first=$(head -n 1 "$1")
case "$first" in
  Merge* | Revert* | fixup!* | squash!*) exit 0 ;;
esac
if ! printf '%s' "$first" | grep -Eq '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .+'; then
  echo "提交信息需要符合 Conventional Commits 格式，例如：feat: 新增第三层「间隙沙漠」" >&2
  echo "当前：$first" >&2
  exit 1
fi
